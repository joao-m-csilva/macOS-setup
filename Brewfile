# ==================================================
# =========== Development Environment ==============
# ==================================================

# ==================================================
# =============== Version Control ==================
# ==================================================

# Official GitHub CLI (Pull Requests, Issues, Repositories, etc.)
brew "gh"

# Displays the project directory structure as a tree
# Useful for documentation and README generation
brew "tree"

# ==================================================
# =================== Node.js ======================
# ==================================================

# Node.js version manager
brew "nvm"

# ==================================================
# ================== Databases =====================
# ==================================================

# PostgreSQL for local development
brew "postgresql@18"

# ==================================================
# =================== CLI Tools ====================
# ==================================================

# Official Amazon Web Services CLI
brew "awscli"

# Modern GNU Bash shell
brew "bash"

# System information fetch tool
brew "fastfetch"

# Interactive finder for files, directories, and shell history
brew "fzf"

# Vim-fork focused on extensibility and usability
brew "neovim"

# Prompt theme engine for any shell
brew "oh-my-posh"

# Extremely fast text search across files
# Used internally by VS Code
brew "ripgrep"

# Terminal multiplexer
brew "tmux"

# Smarter cd command for quick directory navigation
brew "zoxide"

# ==================================================
# ==================== Fonts =======================
# ==================================================

# Nerd Fonts required for Oh My Posh icons and glyphs
cask "font-caskaydia-cove-nerd-font"
cask "font-jetbrains-mono-nerd-font"

# ==================================================
# ================= Applications ===================
# ==================================================

# Terminal emulator for macOS
cask "iterm2"

# Primary code editor
cask "visual-studio-code"

# Browser for development and testing
cask "google-chrome"

# Docker Desktop (includes Docker Engine, CLI, and Docker Compose)
cask "docker-desktop"

# Database management client
cask "dbeaver-community"

# API testing tool
cask "postman"

# Notes and studies
cask "notion"
