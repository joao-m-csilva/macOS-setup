# ==================================================
# ======== Ambiente de Desenvolvimento =============
# ==================================================

# ==================================================
# ============= Versionamento =======================
# ==================================================

# Sistema de controle de versão distribuído
brew "git"

# CLI oficial do GitHub (Pull Requests, Issues, Repositórios, etc.)
brew "gh"


# ==================================================
# ================== Node.js ========================
# ==================================================

# Gerenciador de versões do Node.js
brew "nvm"

# Runtime JavaScript
brew "node"


# ==================================================
# =============== Banco de Dados ====================
# ==================================================

# PostgreSQL para desenvolvimento local
brew "postgresql"


# ==================================================
# =========== Ferramentas de Terminal ==============
# ==================================================

# Busca extremamente rápida de texto em arquivos
# Utilizado internamente pelo VS Code
brew "ripgrep"

# Busca interativa para arquivos, diretórios e histórico do terminal
brew "fzf"


# ==================================================
# ================= Aplicações ======================
# ==================================================

# Editor principal de código
cask "visual-studio-code"

# Navegador utilizado para desenvolvimento e testes
cask "google-chrome"

# Terminal moderno para macOS
cask "warp"

# Docker Desktop (inclui Docker Engine, CLI e Docker Compose)
cask "docker"

# Cliente para gerenciamento de bancos de dados
cask "dbeaver"

# IDE para desenvolvimento Java e Kotlin
cask "intellij-idea"

